# Copia este archivo a .env.local y llena los valores. Nunca subas .env.local a git.

# Postgres (VPS). Ej: postgres://usuario:clave@host:5432/cobrandoo
DATABASE_URL=
# disable | require (cifra, sin validar cert) | verify (cifra y valida cert)
DATABASE_SSL=require
# Conexiones por instancia. En Vercel mantenlo bajo (cada función abre su propio pool).
DATABASE_POOL_MAX=3

# Secreto para firmar los JWT. Genera uno con: openssl rand -hex 64
JWT_SECRET=

# Protege la tarea diaria /api/cron/diario (Vercel la envía como "Authorization: Bearer ...").
# Corre a las 00:05 hora Colombia (05:05 UTC). Genera uno con: openssl rand -hex 32
CRON_SECRET=

# Solo para crear el super admin: npm run db:super-admin -- <correo> "<Nombre>"
SUPER_ADMIN_PASSWORD=
